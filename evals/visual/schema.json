{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retro-futuristic-cover/v3/visual-verdict",
  "title": "Retro Futuristic Cover visual verdict",
  "description": "A structured record of machine delivery checks, visual observations, and separate aesthetic preference.",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "proof",
    "subject_assembly",
    "screen_state",
    "machine_checks",
    "copy",
    "visual_review",
    "hard_verdict",
    "repair_mode",
    "verdict",
    "root_cause_class",
    "aesthetic_preference"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^V[1-3]$"},
    "proof": {"$ref": "#/$defs/proof"},
    "subject_assembly": {"$ref": "#/$defs/subjectAssembly"},
    "screen_state": {"$ref": "#/$defs/screenState"},
    "machine_checks": {"$ref": "#/$defs/machineChecks"},
    "copy": {"$ref": "#/$defs/copy"},
    "visual_review": {"$ref": "#/$defs/visualReview"},
    "hard_verdict": {"enum": ["PASS", "FAIL"]},
    "repair_mode": {"enum": ["NONE", "EDIT", "REGENERATE"]},
    "verdict": {"enum": ["PASS", "EDIT", "REGENERATE", "INVALID_INPUT"]},
    "root_cause_class": {"$ref": "#/$defs/rootCause"},
    "aesthetic_preference": {"$ref": "#/$defs/aestheticPreference"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
    "evidence": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["path", "manifest_path", "carrier", "canvas", "layout_family"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "carrier": {
          "enum": ["SOCIAL_COVER", "EDITORIAL_POSTER", "PHOTO_COVER", "PACKAGING_FACE", "RECORD_SLEEVE"]
        },
        "canvas": {
          "type": "object",
          "required": ["width", "height", "ratio"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"}
          },
          "additionalProperties": true
        },
        "layout_family": {
          "enum": ["ASYMMETRIC_COUNTERWEIGHT", "CENTERED_ANCHOR", "FRAME_THRESHOLD", "PERSPECTIVE_VECTOR", "RHYTHMIC_FIELD", "TYPE_DOMINANT_FIELD", "IMAGE_MASK_FIELD", "INFORMATION_AXIS"]
        }
      },
      "additionalProperties": true
    },
    "subjectAssembly": {
      "enum": ["SINGLE_OBJECT", "COMPOUND_SET", "PRIMARY_SATELLITES", "REPEATED_FAMILY"]
    },
    "screenState": {
      "enum": ["NOT_APPLICABLE", "DORMANT", "SIGNAL", "CARRIER"]
    },
    "machineChecks": {
      "type": "object",
      "required": ["file_exists", "format", "dimensions", "ratio", "opacity"],
      "properties": {
        "file_exists": {"type": "boolean"},
        "format": {"$ref": "#/$defs/machineFormat"},
        "dimensions": {"$ref": "#/$defs/machineDimensions"},
        "ratio": {"$ref": "#/$defs/machineRatio"},
        "opacity": {"$ref": "#/$defs/machineOpacity"}
      },
      "additionalProperties": true
    },
    "machineFormat": {
      "type": "object",
      "required": ["expected", "actual", "pass"],
      "properties": {
        "expected": {"enum": ["PNG"]},
        "actual": {"type": ["string", "null"]},
        "pass": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "machineDimensions": {
      "type": "object",
      "required": ["expected", "actual", "pass"],
      "properties": {
        "expected": {"$ref": "#/$defs/dimensions"},
        "actual": {"anyOf": [{"$ref": "#/$defs/dimensions"}, {"type": "null"}]},
        "pass": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "machineRatio": {
      "type": "object",
      "required": ["expected", "actual", "pass"],
      "properties": {
        "expected": {"type": "string"},
        "actual": {"type": ["string", "null"]},
        "pass": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "machineOpacity": {
      "type": "object",
      "required": ["opaque", "has_alpha", "pass"],
      "properties": {
        "opaque": {"type": "boolean"},
        "has_alpha": {"type": "boolean"},
        "pass": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "copy": {
      "type": "object",
      "required": ["contract", "locked", "observed", "intrinsic_artifact_text", "duplicates", "extra"],
      "properties": {
        "contract": {"enum": ["THREE_ELEMENT_COVER", "EDITORIAL_POSTER_5_TO_7"]},
        "locked": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/lockedCopy"}},
        "observed": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observedCopy"}},
        "intrinsic_artifact_text": {"type": "array", "items": {"type": "string"}},
        "duplicates": {"type": "array", "items": {"type": "string"}},
        "extra": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "lockedCopy": {
      "type": "object",
      "required": ["role", "text", "location"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "location": {"enum": ["external", "screen"]}
      },
      "additionalProperties": true
    },
    "observedCopy": {
      "type": "object",
      "required": ["text", "role", "count", "locations"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1},
        "locations": {"type": "array", "minItems": 1, "items": {"enum": ["external", "screen"]}}
      },
      "additionalProperties": true
    },
    "visualReview": {
      "type": "object",
      "required": [
        "full_size",
        "thumbnail_25_percent",
        "background_coverage",
        "first_reading_event",
        "hierarchy",
        "subject_origin_recognition",
        "subject_mass_unity",
        "release_zone_visibility",
        "support_copy_structural_attachment",
        "screen_state_compliance",
        "layout_failure_signals"
      ],
      "properties": {
        "full_size": {"$ref": "#/$defs/evidence"},
        "thumbnail_25_percent": {"$ref": "#/$defs/evidence"},
        "background_coverage": {"$ref": "#/$defs/backgroundCoverage"},
        "first_reading_event": {
          "type": "object",
          "required": ["value", "evidence"],
          "properties": {
            "value": {"enum": ["TITLE", "SUBJECT", "SUPPORT", "OTHER"]},
            "evidence": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "hierarchy": {
          "type": "object",
          "required": ["title", "subject", "support", "evidence"],
          "properties": {
            "title": {"$ref": "#/$defs/status"},
            "subject": {"$ref": "#/$defs/status"},
            "support": {"$ref": "#/$defs/status"},
            "evidence": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "subject_origin_recognition": {"$ref": "#/$defs/evidence"},
        "subject_mass_unity": {"$ref": "#/$defs/evidence"},
        "release_zone_visibility": {"$ref": "#/$defs/evidence"},
        "support_copy_structural_attachment": {"$ref": "#/$defs/evidence"},
        "screen_state_compliance": {
          "type": "object",
          "required": ["status", "state", "evidence"],
          "properties": {
            "status": {"$ref": "#/$defs/status"},
            "state": {"$ref": "#/$defs/screenState"},
            "evidence": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "layout_failure_signals": {
          "type": "object",
          "required": ["observed", "evidence"],
          "properties": {
            "observed": {"type": "array", "items": {"type": "string"}},
            "evidence": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "backgroundCoverage": {
      "type": "object",
      "required": ["status", "corners", "perimeter", "evidence"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "corners": {
          "type": "object",
          "required": ["top_left", "top_right", "bottom_left", "bottom_right"],
          "properties": {
            "top_left": {"$ref": "#/$defs/status"},
            "top_right": {"$ref": "#/$defs/status"},
            "bottom_left": {"$ref": "#/$defs/status"},
            "bottom_right": {"$ref": "#/$defs/status"}
          },
          "additionalProperties": true
        },
        "perimeter": {"$ref": "#/$defs/status"},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "rootCause": {
      "enum": ["NONE", "DELIVERY", "BACKGROUND_COVERAGE", "TEXT_INVENTORY", "TITLE_HIERARCHY", "SCREEN_DUPLICATION", "SUBJECT_MASS", "LAYOUT", "SUBJECT_ORIGIN", "SUPPORT_ATTACHMENT", "OTHER"]
    },
    "aestheticPreference": {
      "type": "object",
      "required": ["rating", "evidence"],
      "properties": {
        "rating": {"enum": ["PREFERRED", "ACCEPTABLE", "NOT_PREFERRED"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
