{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retro-futuristic-cover/v3/design-manifest",
  "title": "Retro Futuristic Cover V3 Design Manifest",
  "type": "object",
  "required": [
    "carrier",
    "layout_family",
    "layout_family_id",
    "layout_attention_contract",
    "layout_allowed_subject_assemblies",
    "layout_required_operators",
    "layout_title_zone",
    "layout_object_slot",
    "layout_collision_rule",
    "layout_support_zones",
    "layout_crop_rule",
    "layout_failure_signals",
    "layout_thumbnail_test",
    "composition_primitives",
    "subject_assembly",
    "subject_mass_rule",
    "composition_operators",
    "composition_sentence",
    "subject_origin_mode",
    "render_treatment",
    "scale_role",
    "screen_state",
    "screen_content_role",
    "screen_content_source",
    "screen_display_language",
    "screen_copy_element",
    "screen_instance_rule",
    "focal_event",
    "release_zone",
    "palette",
    "gradient_topology",
    "primary_form",
    "type_mode",
    "detail_grammar"
  ],
  "properties": {
    "carrier": {"type": "string"},
    "layout_family": {"type": "string"},
    "layout_family_id": {"enum": ["ASYMMETRIC_COUNTERWEIGHT", "CENTERED_ANCHOR", "FRAME_THRESHOLD", "PERSPECTIVE_VECTOR", "RHYTHMIC_FIELD", "TYPE_DOMINANT_FIELD", "IMAGE_MASK_FIELD", "INFORMATION_AXIS"]},
    "layout_attention_contract": {
      "type": "object",
      "required": ["title_percent", "subject_percent", "support_percent"],
      "properties": {
        "title_percent": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "subject_percent": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "support_percent": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
      }
    },
    "layout_allowed_subject_assemblies": {"type": "array", "minItems": 1, "items": {"enum": ["SINGLE_OBJECT", "COMPOUND_SET", "PRIMARY_SATELLITES", "REPEATED_FAMILY"]}},
    "layout_required_operators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "layout_title_zone": {"type": "string"},
    "layout_object_slot": {"type": "string"},
    "layout_collision_rule": {"type": "string"},
    "layout_support_zones": {"type": "array", "items": {"type": "string"}},
    "layout_crop_rule": {"type": "string"},
    "layout_failure_signals": {"type": "array", "items": {"type": "string"}},
    "layout_thumbnail_test": {"type": "string"},
    "composition_primitives": {"type": "array", "minItems": 4, "items": {"enum": ["TITLE_MASS", "SUBJECT_MASS", "SUPPORT_SYSTEM", "RELEASE_ZONE"]}},
    "subject_assembly": {"enum": ["SINGLE_OBJECT", "COMPOUND_SET", "PRIMARY_SATELLITES", "REPEATED_FAMILY"]},
    "subject_assembly_count": {"type": "string"},
    "subject_mass_rule": {"type": "string"},
    "composition_operators": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "category", "definition"],
        "properties": {
          "id": {"type": "string"},
          "category": {"enum": ["PRIMARY_RELATION", "FOCAL_OPERATION", "SUPPORT_ALIGNMENT"]},
          "definition": {"type": "string"}
        }
      }
    },
    "composition_sentence": {"type": "string"},
    "subject_origin_mode": {"enum": ["ABSTRACT_FORM", "ARCHIVE_ARTIFACT", "SPECULATIVE_OBJECT", "NOT_APPLICABLE_SUPPLIED_IMAGE"]},
    "render_treatment": {"enum": ["FAITHFUL_RETAINED", "ENVIRONMENT_GRADED", "PALETTE_ASSIMILATED"]},
    "scale_role": {"enum": ["FIELD_STRUCTURE", "MONUMENTAL_FRAGMENT", "INTEGRATED_HERO", "CENTERPIECE_ARTIFACT", "SPECIMEN_ANCHOR", "REPEATED_FIELD"]},
    "source_asset_mode": {"enum": ["NONE", "FAITHFUL_IMAGE", "ABSTRACT_SYMBOL"]},
    "image_role": {"enum": ["NONE", "HERO_PHOTOGRAPH", "CROPPED_FRAGMENT", "REPEATED_SPECIMEN", "TEXTURE_SOURCE"]},
    "object_family": {"type": "string"},
    "speculative_morphology": {"type": "string"},
    "speculative_morphology_source": {"enum": ["NOT_APPLICABLE", "ARCHETYPE_PRESET", "CUSTOM"]},
    "speculative_morphology_name": {"type": "string"},
    "speculative_morphology_shape_ancestry": {"type": "string"},
    "screen_state": {"enum": ["NOT_APPLICABLE", "DORMANT", "SIGNAL", "CARRIER"]},
    "screen_content_role": {"enum": ["NONE", "NONVERBAL_SIGNAL", "SUPPORT_ELEMENT"]},
    "screen_content_source": {"enum": ["NONE", "GENERATED_NONVERBAL", "LOCKED_DESIGNED_COPY"]},
    "screen_display_language": {"enum": ["NOT_APPLICABLE", "DORMANT_GLASS", "PHOSPHOR_SIGNAL", "LOW_RES_TERMINAL"]},
    "screen_copy_element": {"type": "string"},
    "screen_instance_rule": {"type": "string"},
    "focal_event": {"type": "string"},
    "release_zone": {"type": "string"},
    "palette": {"type": "string"},
    "gradient_topology": {"type": "string"},
    "primary_form": {"type": "string"},
    "type_mode": {"type": "string"},
    "detail_grammar": {"type": "string"},
    "material_treatment": {"type": "string"},
    "text_contract": {"enum": ["THREE_ELEMENT_COVER", "EDITORIAL_POSTER_5_TO_7"]},
    "intrinsic_artifact_text_policy": {"type": "string"}
  },
  "additionalProperties": true
}
