{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retro-futuristic-cover/v3/generation-brief",
  "title": "Compiled image-generation brief",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "brief_version",
    "canvas",
    "carrier_contract",
    "text_contract",
    "designed_text_inventory",
    "designed_text_count",
    "typography_contract",
    "concept_contract",
    "composition",
    "subject",
    "palette",
    "background",
    "generation_call",
    "negative_constraints",
    "generator_instruction"
  ],
  "properties": {
    "brief_version": {"const": 1},
    "canvas": {
      "type": "object",
      "required": ["width", "height", "ratio"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "ratio": {"type": "string"}
      }
    },
    "carrier_contract": {"type": "object"},
    "text_contract": {"enum": ["THREE_ELEMENT_COVER", "EDITORIAL_POSTER_5_TO_7"]},
    "designed_text_inventory": {"type": "array", "minItems": 3},
    "designed_text_count": {"type": "integer", "minimum": 3, "maximum": 7},
    "typography_contract": {
      "type": "object",
      "required": ["mode", "title", "category_label", "supporting_copy", "cluster", "thumbnail_rule"]
    },
    "concept_contract": {"$ref": "generation-content.schema.json#/$defs/conceptContract"},
    "composition": {"type": "object"},
    "subject": {
      "type": "object",
      "required": ["assembly", "mass_rule"],
      "properties": {
        "assembly": {"enum": ["SINGLE_OBJECT", "COMPOUND_SET", "PRIMARY_SATELLITES", "REPEATED_FAMILY"]},
        "mass_rule": {"type": "string", "minLength": 1},
        "assembly_plan": {
          "oneOf": [
            {"$ref": "generation-content.schema.json#/$defs/compoundSetPlan"},
            {"$ref": "generation-content.schema.json#/$defs/primarySatellitesPlan"},
            {"$ref": "generation-content.schema.json#/$defs/repeatedFamilyPlan"}
          ]
        }
      }
    },
    "palette": {"type": "object"},
    "background": {"type": "object"},
    "generation_call": {
      "type": "object",
      "required": ["style_reference_path", "source_asset_paths", "referenced_image_paths", "reference_instruction"],
      "properties": {
        "style_reference_path": {"type": "string", "minLength": 1},
        "source_asset_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "referenced_image_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reference_instruction": {"type": "string", "minLength": 1}
      }
    },
    "negative_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generator_instruction": {"type": "string", "minLength": 1}
  }
}
